# Domínio final do site (sem barra no fim)
NEXT_PUBLIC_SITE_URL=https://www.meritumhoteis.com.br

# Formulário "Fale com a Méritum" (envio por e-mail via Resend)
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# Ambientes de teste (subdomínio): "true" bloqueia a indexação (robots.txt com Disallow: / e meta noindex, nofollow).
# Deixar ausente em produção. Precisa estar definida antes do build.
# NEXT_PUBLIC_NOINDEX=true

# Verificação do Google Search Console e do Bing Webmaster Tools (só o código)
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
